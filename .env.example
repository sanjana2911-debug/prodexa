# ============================================
# Prodexa Backend - Environment Configuration
# ============================================

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/prodexa?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=your_32_char_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_32_char_refresh_secret_key_change_in_production

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Redis Configuration (optional - app works without Redis)
REDIS_URL=redis://localhost:6379

# SMTP Configuration (for password reset emails)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# File Upload
MAX_FILE_SIZE=5242880